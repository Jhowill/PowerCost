{
  "expo": {
    "name": "PowerCost",
    "slug": "powercost",
    "description": "Estimate the energy consumption and monthly cost of household appliances.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/store/expo-app-icon-1024.png",
    "scheme": "powercost",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.powercost.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#04170F",
        "foregroundImage": "./assets/store/android-adaptive-foreground-432.png",
        "monochromeImage": "./assets/store/android-monochrome-432.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.powercost.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/store/web-app-icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/store/expo-app-icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5FAF4",
          "dark": {
            "backgroundColor": "#07130D"
          }
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4042606302261972~7166053426",
          "iosAppId": "ca-app-pub-4042606302261972~6187033735",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier may be used to deliver and measure more relevant ads."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19206c9b-d0a2-43ae-a7c4-a25cd07a4344"
      }
    },
    "owner": "jhowill"
  }
}
