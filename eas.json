{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": { "EXPO_PUBLIC_ADS_TEST_MODE": "true" },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": { "EXPO_PUBLIC_ADS_TEST_MODE": "true" },
      "distribution": "internal"
    },
    "production": {
      "env": { "EXPO_PUBLIC_ADS_TEST_MODE": "false" },
      "autoIncrement": true
    }
  }
}
